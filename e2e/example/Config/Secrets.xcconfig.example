// Copy to Secrets.xcconfig (gitignored) and paste your workspace SDK key from the LinkTrail
// dashboard. Never commit the real key.
//
//   cp e2e/example/Config/Secrets.xcconfig.example example/Config/Secrets.xcconfig

LINKTRAIL_API_KEY = lt_live_REPLACE_WITH_YOUR_KEY

// Optional: turn the SDK's log lines off in this build (default YES).
// LINKTRAIL_LOGS = NO
